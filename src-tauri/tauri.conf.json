{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Enshrouded Save Editor",
  "version": "1.0.2",
  "identifier": "local.nicolas.enshrouded-save-editor",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Enshrouded Save Editor",
        "width": 1920,
        "height": 1080,
        "minWidth": 1280,
        "minHeight": 720,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico"
    ]
  }
}
